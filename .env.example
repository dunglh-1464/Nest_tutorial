NODE_ENV=development
PORT=3000
APP_NAME=Nest Tutorial
DEFAULT_LANGUAGE=en

# Database — matches docker-compose.yml defaults
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nest
DB_PASSWORD=nest_password
DB_NAME=nest_tutorial
MIGRATIONS_TABLE_NAME=migrationsTableName

# End-to-end test database (Pull 6)
DB_TEST_PORT=5433

# Redis — token blacklist
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — generate your own: openssl rand -base64 32
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
